# Роздача розширень Chrome (Zapchastyna). Не для людей — сюди ходить браузер.
/ext/*
  X-Robots-Tag: noindex

# Маніфест оновлень читається браузером кожні кілька годин —
# кеш короткий, інакше нова версія розширення доїжджатиме із запізненням.
/ext/updates.xml
  Content-Type: text/xml; charset=utf-8
  Cache-Control: public, max-age=300

# Сам пакет розширення. Chrome вимагає саме цей Content-Type.
/ext/*.crx
  Content-Type: application/x-chrome-extension
  Cache-Control: public, max-age=86400
